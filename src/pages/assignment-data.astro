---
import PageLayout from '../layouts/PageLayout.astro';
import data from '../data/assignment/apex.json';

const pct = (value: number, digits = 1) => `${value.toFixed(digits)}%`;
const daily = data.daily as [string, number][];
const peak = daily.reduce((best, row) => (row[1] > best[1] ? row : best));
const allRanks = data.ranks.find((row) => row.filter === 'all')!;
const tierOrder = ['Bronze', 'Silver', 'Gold', 'Platinum', 'Diamond', 'Masterpred'];
const tiers = tierOrder.map((name) => data.ranks.find((row) => row.filter === name)!);
const bronze = tiers[0];
const masterpred = tiers[tiers.length - 1];
const tierLabel = (name: string) => (name === 'Masterpred' ? 'Master & Predator' : name);
const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const formatHour = (stamp: string) => `${formatDate(stamp.slice(0, 10))}, ${stamp.slice(11)}:00`;

const downloads = [
  ['bloodhound_daily_2025-11-01_2026-10-26.csv', 'Bloodhound daily pick rate'],
  ['daily_all_legends_2025-11-01_2026-10-26.csv', 'Daily pick rate, all legends'],
  ['weekly_all_legends_2025-11-01_2026-10-26.csv', 'Weekly pick rate, all legends'],
  ['rank_snapshot_2026-10-26.csv', 'Bloodhound by rank, Oct 26, 2026'],
  ['bloodhound_jumps_2025-11-01_2026-10-26.csv', 'Bloodhound jumps'],
];
---

<PageLayout title="Assignment data — broccosite" description="Apex Legends pick-rate data." noindex>
  <article class="page-width-wide assignment">
    <header class="assignment-header">
      <h1>Assignment data</h1>
      <p class="assignment-source">
        Apex Legends pick rates from <a href="https://apexlegendsstatus.com/game-stats/legends-pick-rates">Apex Legends Status</a>, pulled Oct 26, 2026.
      </p>
    </header>

    <section class="stat-row" aria-label="Bloodhound at a glance">
      <div class="stat">
        <span class="stat-label">Bloodhound, all ranks today</span>
        <span class="stat-value">{pct(allRanks.bh)}</span>
        <span class="stat-note">{allRanks.pos.replace('/', ' of ')}</span>
      </div>
      <div class="stat">
        <span class="stat-label">Daily peak, past year</span>
        <span class="stat-value">{pct(peak[1], 2)}</span>
        <span class="stat-note">{formatDate(peak[0])}</span>
      </div>
      <div class="stat">
        <span class="stat-label">Bronze</span>
        <span class="stat-value">{pct(bronze.bh)}</span>
        <span class="stat-note">{bronze.pos.replace('/', ' of ')}</span>
      </div>
      <div class="stat">
        <span class="stat-label">Master &amp; Predator</span>
        <span class="stat-value">{pct(masterpred.bh)}</span>
        <span class="stat-note">{masterpred.pos.replace('/', ' of ')}</span>
      </div>
    </section>

    <section class="figure">
      <h2>Bloodhound daily pick rate</h2>
      <p class="figure-meta">All ranks, Nov 1, 2025 – Oct 26, 2026. No data Nov 12–27, 2025.</p>
      <div class="chart" id="chart-daily" role="img" aria-label="Line chart of Bloodhound's daily pick rate over the past year"></div>
    </section>

    <section class="figure">
      <h2>Bloodhound by rank</h2>
      <p class="figure-meta">Current snapshot, Oct 26, 2026. Position is out of 28 legends.</p>
      <div class="chart" id="chart-ranks" role="img" aria-label="Bar chart of Bloodhound's pick rate in each rank"></div>
      <table class="data-table">
        <thead>
          <tr><th scope="col">Rank</th><th scope="col">Bloodhound</th><th scope="col">Position</th><th scope="col">Most picked</th></tr>
        </thead>
        <tbody>
          {[...tiers, allRanks].map((row) => (
            <tr>
              <th scope="row">{row.filter === 'all' ? 'All ranks' : tierLabel(row.filter)}</th>
              <td>{pct(row.bh)}</td>
              <td>{row.pos}</td>
              <td>{row.top} ({pct(row.topPct)})</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="figure">
      <h2>Bloodhound jumps</h2>
      <p class="figure-meta">Hourly pick rate, all ranks, two days before to four days after each jump. Same scale on every panel.</p>
      <div class="multiples" id="chart-jumps"></div>
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Jump</th>
            <th scope="col">Hour before</th>
            <th scope="col">Hour after</th>
            <th scope="col">Hourly peak</th>
            <th scope="col">Prior 7-day avg</th>
            <th scope="col">4 weeks later</th>
          </tr>
        </thead>
        <tbody>
          {data.jumps.map((jump) => (
            <tr>
              <th scope="row">{formatHour(jump.hour)}</th>
              <td>{pct(jump.before, 2)}</td>
              <td>{pct(jump.after, 2)}</td>
              <td>{pct(jump.peak, 2)}</td>
              <td>{pct(jump.pre7, 2)}</td>
              <td>{pct(jump.week4, 2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="figure-meta">Hours are as published by the source, which doesn't state a timezone. “4 weeks later” is the daily average 22–28 days after.</p>
    </section>

    <section class="figure">
      <h2>All legends today</h2>
      <div class="segmented" role="group" aria-label="Rank filter">
        <button type="button" data-snap="all" aria-pressed="true">All ranks</button>
        <button type="button" data-snap="mp" aria-pressed="false">Master &amp; Predator</button>
      </div>
      <div class="chart" id="chart-snapshot" role="img" aria-label="Bar chart of every legend's current pick rate"></div>
    </section>

    <section class="figure">
      <h2>Weekly pick rate, every legend</h2>
      <p class="figure-meta">Monday weeks, all ranks. Rows sorted by average over the year.</p>
      <div class="chart chart-scroll" id="chart-heatmap" role="img" aria-label="Heatmap of weekly pick rate for every legend"></div>
      <div class="heat-legend" id="heat-legend"></div>
    </section>

    <section class="figure">
      <h2>Downloads</h2>
      <ul class="downloads">
        {downloads.map(([file, label]) => (
          <li><a href={`/assignment-data/${file}`} download>{label}</a> <span class="figure-meta">{file}</span></li>
        ))}
      </ul>
    </section>
  </article>

  <div class="chart-tooltip" id="chart-tooltip" role="status" hidden></div>
</PageLayout>

<style>
  .assignment {
    --chart-line: var(--leaf);
    --chart-muted: #c4c7bf;
    --chart-grid: #e4e2d9;
    padding-block: clamp(2rem, 4vw, 3rem) clamp(4rem, 8vw, 6rem);
  }
  .assignment-header { margin-bottom: 2rem; }
  .assignment-header h1 { margin-bottom: 0.5rem; font-size: clamp(2.2rem, 5vw, 3.2rem); }
  .assignment-source { margin: 0; color: var(--muted); }
  .assignment-source a, .downloads a { color: var(--link); text-underline-offset: 0.2em; }

  .stat-row { display: grid; margin-bottom: 2.5rem; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .stat { display: flex; padding: 1rem 1.15rem; flex-direction: column; gap: 0.15rem; border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); }
  .stat-label { color: var(--muted); font: 600 0.85rem 'Quicksand', sans-serif; }
  .stat-value { font: 700 2rem 'Quicksand', sans-serif; font-variant-numeric: tabular-nums; }
  .stat-note { color: var(--muted); font-size: 0.85rem; }

  .figure { margin-bottom: 3rem; padding: 1.25rem; border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); }
  .figure h2 { margin-bottom: 0.35rem; font-size: 1.35rem; }
  .figure-meta { margin: 0 0 1rem; color: var(--muted); font-size: 0.875rem; }
  .chart { position: relative; width: 100%; }
  .chart-scroll { overflow-x: auto; }
  .multiples { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); margin-bottom: 1rem; }
  .multiples h3 { margin: 0 0 0.25rem; font-size: 0.95rem; }

  .data-table { width: 100%; margin: 1rem 0; border-collapse: collapse; font-size: 0.9rem; font-variant-numeric: tabular-nums; }
  .data-table th, .data-table td { padding: 0.45rem 0.6rem; border-bottom: 1px solid var(--line); text-align: left; }
  .data-table thead th { color: var(--muted); font: 600 0.8rem 'Quicksand', sans-serif; }
  @media (max-width: 40rem) { .data-table { display: block; overflow-x: auto; white-space: nowrap; } }

  .segmented { display: inline-flex; margin-bottom: 1rem; padding: 0.2rem; gap: 0.2rem; border: 1px solid var(--line); border-radius: var(--radius-button); }
  .segmented button { padding: 0.35rem 0.8rem; border: 0; border-radius: calc(var(--radius-button) - 4px); color: var(--ink-soft); background: transparent; font: 600 0.85rem 'Quicksand', sans-serif; cursor: pointer; }
  .segmented button[aria-pressed='true'] { color: var(--brocco-current-ink); background: var(--brocco-current); }

  .heat-legend { display: flex; margin-top: 0.75rem; gap: 0.5rem; align-items: center; color: var(--muted); font-size: 0.8rem; }
  .heat-legend span.swatch { width: 1.4rem; height: 0.7rem; border-radius: 3px; }

  .downloads { margin: 0; padding-left: 1.2rem; }
  .downloads li { margin-bottom: 0.4rem; }
  .downloads .figure-meta { margin: 0 0 0 0.35rem; font-size: 0.8rem; }

  .chart-tooltip { position: fixed; z-index: 50; padding: 0.45rem 0.65rem; border: 1px solid var(--line); border-radius: 10px; color: var(--ink); background: var(--surface); box-shadow: var(--shadow-lifted); font-size: 0.85rem; font-variant-numeric: tabular-nums; pointer-events: none; white-space: nowrap; }
  .chart-tooltip strong { font-family: 'Quicksand', sans-serif; }

  :global(.chart svg text) { fill: var(--muted); font: 500 11px 'Outfit', sans-serif; font-variant-numeric: tabular-nums; }
  :global(.chart svg text.label-strong) { fill: var(--ink); font-weight: 700; }
</style>

<script>
  import data from '../data/assignment/apex.json';

  const NS = 'http://www.w3.org/2000/svg';
  const tooltip = document.getElementById('chart-tooltip')!;
  const css = getComputedStyle(document.querySelector('.assignment')!);
  const LINE = css.getPropertyValue('--chart-line').trim();
  const MUTED = css.getPropertyValue('--chart-muted').trim();
  const GRID = css.getPropertyValue('--chart-grid').trim();
  const SURFACE = getComputedStyle(document.body).getPropertyValue('--surface').trim();
  const RAMP = ['#cde2fb', '#9ec5f4', '#6da7ec', '#3987e5', '#256abf', '#184f95', '#0d366b'];

  type Attrs = Record<string, string | number>;
  const el = (tag: string, attrs: Attrs = {}, parent?: Element) => {
    const node = document.createElementNS(NS, tag);
    for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, String(value));
    parent?.appendChild(node);
    return node;
  };
  const text = (parent: Element, x: number, y: number, content: string, attrs: Attrs = {}) => {
    const node = el('text', { x, y, ...attrs }, parent);
    node.textContent = content;
    return node;
  };
  const svgFor = (host: HTMLElement, height: number, width = host.clientWidth) => {
    host.replaceChildren();
    return el('svg', { width, height, viewBox: `0 0 ${width} ${height}` }, host) as SVGSVGElement;
  };
  const showTip = (html: string, event: { clientX: number; clientY: number }) => {
    tooltip.innerHTML = html;
    tooltip.hidden = false;
    const { width, height } = tooltip.getBoundingClientRect();
    let x = event.clientX + 14;
    if (x + width > window.innerWidth - 8) x = event.clientX - width - 14;
    tooltip.style.left = `${Math.max(8, x)}px`;
    tooltip.style.top = `${Math.max(8, event.clientY - height - 12)}px`;
  };
  const hideTip = () => { tooltip.hidden = true; };
  const niceMax = (value: number) => {
    const step = value > 8 ? 4 : value > 4 ? 2 : value > 2 ? 1 : 0.5;
    return { max: Math.ceil(value / step) * step, step };
  };
  const dayMs = 86_400_000;
  const parseDay = (iso: string) => Date.parse(`${iso}T00:00:00Z`);
  const parseHour = (stamp: string) => Date.parse(`${stamp.slice(0, 10)}T${stamp.slice(11)}:00:00Z`);
  const fmtDay = (ms: number, withYear = true) =>
    new Date(ms).toLocaleDateString('en-US', { month: 'short', day: 'numeric', ...(withYear ? { year: 'numeric' } : {}), timeZone: 'UTC' });
  const fmtHour = (ms: number) => `${fmtDay(ms, false)}, ${String(new Date(ms).getUTCHours()).padStart(2, '0')}:00`;

  // Shared line chart with a crosshair; breaks the line where consecutive points are further apart than maxGap.
  function lineChart(host: HTMLElement, points: [number, number][], opts: { height: number; yMax: number; maxGap: number; xTicks: number[]; xFormat: (ms: number) => string; tip: (p: [number, number]) => string; marks?: [number, string][] }) {
    const width = host.clientWidth;
    const m = { top: 12, right: 20, bottom: 26, left: 36 };
    const svg = svgFor(host, opts.height, width);
    const x0 = points[0][0], x1 = points[points.length - 1][0];
    const { max, step } = niceMax(opts.yMax);
    const sx = (v: number) => m.left + ((v - x0) / (x1 - x0)) * (width - m.left - m.right);
    const sy = (v: number) => opts.height - m.bottom - (v / max) * (opts.height - m.top - m.bottom);

    for (let v = 0; v <= max + 1e-9; v += step) {
      el('line', { x1: m.left, x2: width - m.right, y1: sy(v), y2: sy(v), stroke: v === 0 ? MUTED : GRID, 'stroke-width': 1 }, svg);
      text(svg, m.left - 6, sy(v) + 4, `${v}%`, { 'text-anchor': 'end' });
    }
    for (const tick of opts.xTicks) text(svg, sx(tick), opts.height - 8, opts.xFormat(tick), { 'text-anchor': 'middle' });

    let d = '';
    points.forEach(([t, v], i) => {
      const gap = i > 0 && t - points[i - 1][0] > opts.maxGap;
      d += `${i === 0 || gap ? 'M' : 'L'}${sx(t).toFixed(1)},${sy(v).toFixed(1)}`;
    });
    el('path', { d, fill: 'none', stroke: LINE, 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' }, svg);

    for (const [t, label] of opts.marks ?? []) {
      el('line', { x1: sx(t), x2: sx(t), y1: m.top, y2: opts.height - m.bottom, stroke: MUTED, 'stroke-dasharray': '3 3' }, svg);
      text(svg, sx(t) + 4, m.top + 10, label, { class: 'label-strong' });
    }

    const guide = el('line', { y1: m.top, y2: opts.height - m.bottom, stroke: MUTED, visibility: 'hidden' }, svg);
    const dot = el('circle', { r: 4.5, fill: LINE, stroke: SURFACE, 'stroke-width': 2, visibility: 'hidden' }, svg);
    const hit = el('rect', { x: m.left, y: 0, width: width - m.left - m.right, height: opts.height, fill: 'transparent' }, svg);
    const move = (event: PointerEvent) => {
      const box = svg.getBoundingClientRect();
      const t = x0 + ((event.clientX - box.left - m.left) / (width - m.left - m.right)) * (x1 - x0);
      let best = points[0];
      for (const p of points) if (Math.abs(p[0] - t) < Math.abs(best[0] - t)) best = p;
      for (const node of [guide, dot]) node.setAttribute('visibility', 'visible');
      guide.setAttribute('x1', String(sx(best[0]))); guide.setAttribute('x2', String(sx(best[0])));
      dot.setAttribute('cx', String(sx(best[0]))); dot.setAttribute('cy', String(sy(best[1])));
      showTip(opts.tip(best), event);
    };
    hit.addEventListener('pointermove', move as EventListener);
    hit.addEventListener('pointerleave', () => { guide.setAttribute('visibility', 'hidden'); dot.setAttribute('visibility', 'hidden'); hideTip(); });
  }

  // Horizontal bars; highlighted rows use the accent, others stay neutral.
  function barChart(host: HTMLElement, rows: { label: string; value: number; note?: string; highlight?: boolean }[], max: number) {
    const width = host.clientWidth;
    const rowH = 26, m = { top: 4, right: 96, left: 126 };
    const height = rows.length * rowH + m.top * 2;
    const svg = svgFor(host, height, width);
    const sx = (v: number) => (v / max) * (width - m.left - m.right);
    rows.forEach((row, i) => {
      const y = m.top + i * rowH;
      text(svg, m.left - 8, y + rowH / 2 + 4, row.label, { 'text-anchor': 'end', ...(row.highlight ? { class: 'label-strong' } : {}) });
      const w = Math.max(2, sx(row.value));
      el('rect', { x: m.left, y: y + 5, width: w, height: rowH - 10, rx: 4, fill: row.highlight ? LINE : MUTED }, svg);
      text(svg, m.left + w + 6, y + rowH / 2 + 4, `${row.value.toFixed(1)}%${row.note ? `  ${row.note}` : ''}`, row.highlight ? { class: 'label-strong' } : {});
      const hit = el('rect', { x: 0, y, width, height: rowH, fill: 'transparent' }, svg);
      hit.addEventListener('pointermove', ((event: PointerEvent) => showTip(`<strong>${row.label}</strong><br>${row.value.toFixed(1)}%${row.note ? ` · ${row.note}` : ''}`, event)) as EventListener);
      hit.addEventListener('pointerleave', hideTip);
    });
  }

  function drawDaily() {
    const points = data.daily.map(([day, v]) => [parseDay(day as string), v as number] as [number, number]);
    const ticks: number[] = [];
    for (let month = 0; month < 12; month += 2) ticks.push(Date.UTC(2025, 10 + month, 1));
    lineChart(document.getElementById('chart-daily')!, points, {
      height: 280,
      yMax: Math.max(...points.map((p) => p[1])),
      maxGap: dayMs * 1.5,
      xTicks: ticks,
      xFormat: (ms) => new Date(ms).toLocaleDateString('en-US', { month: 'short', year: '2-digit', timeZone: 'UTC' }),
      tip: ([t, v]) => `<strong>${fmtDay(t)}</strong><br>${v.toFixed(2)}%`,
    });
  }

  function drawRanks() {
    const order = ['Bronze', 'Silver', 'Gold', 'Platinum', 'Diamond', 'Masterpred'];
    const rows = order.map((name) => {
      const row = data.ranks.find((r) => r.filter === name)!;
      return { label: name === 'Masterpred' ? 'Master & Pred' : name, value: row.bh, note: `#${row.pos.split('/')[0]}`, highlight: true };
    });
    barChart(document.getElementById('chart-ranks')!, rows, 5);
  }

  function drawJumps() {
    const host = document.getElementById('chart-jumps')!;
    host.replaceChildren();
    const yMax = Math.max(...data.jumps.map((j) => j.peak));
    // Lay out every panel before measuring, so the grid has its final column widths.
    const charts = data.jumps.map((jump) => {
      const panel = document.createElement('div');
      const title = document.createElement('h3');
      title.textContent = fmtDay(parseDay(jump.hour.slice(0, 10)));
      const chart = document.createElement('div');
      chart.className = 'chart';
      panel.append(title, chart);
      host.appendChild(panel);
      return chart;
    });
    data.jumps.forEach((jump, i) => {
      const points = jump.series.map(([h, v]) => [parseHour(h as string), v as number] as [number, number]);
      const start = points[0][0];
      lineChart(charts[i], points, {
        height: 180,
        yMax,
        maxGap: 3_600_000 * 1.5,
        xTicks: [0, 2, 4].map((d) => start + d * dayMs),
        xFormat: (ms) => fmtDay(ms, false),
        tip: ([t, v]) => `<strong>${fmtHour(t)}</strong><br>${v.toFixed(2)}%`,
        marks: [[parseHour(jump.hour), `${jump.after.toFixed(1)}%`]],
      });
    });
  }

  let snapMode: 'all' | 'mp' = 'all';
  function drawSnapshot() {
    const source = snapMode === 'all' ? data.snapAll : data.snapMP;
    const rows = (source as [string, number][])
      .map(([label, value]) => ({ label, value, highlight: label === 'Bloodhound' }))
      .sort((a, b) => b.value - a.value);
    barChart(document.getElementById('chart-snapshot')!, rows, 18);
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-snap]')) {
    button.addEventListener('click', () => {
      snapMode = button.dataset.snap as 'all' | 'mp';
      for (const other of document.querySelectorAll('[data-snap]')) other.setAttribute('aria-pressed', String(other === button));
      drawSnapshot();
    });
  }

  const bins = [1, 2, 4, 6, 9, 13];
  const binOf = (v: number) => { let i = 0; while (i < bins.length && v >= bins[i]) i++; return i; };
  function drawHeatmap() {
    const host = document.getElementById('chart-heatmap')!;
    const grid = data.grid as Record<string, (number | null)[]>;
    const avg = (vals: (number | null)[]) => { const xs = vals.filter((v): v is number => v !== null); return xs.reduce((a, b) => a + b, 0) / xs.length; };
    const legends = Object.keys(grid).sort((a, b) => avg(grid[b]) - avg(grid[a]));
    const m = { top: 22, left: 92, right: 4 };
    const cellH = 16;
    const width = Math.max(host.clientWidth, 640);
    const cellW = (width - m.left - m.right) / data.weeks.length;
    const svg = svgFor(host, m.top + legends.length * cellH + 4, width);
    data.weeks.forEach((week, i) => {
      if (week.slice(8) <= '07') text(svg, m.left + i * cellW, 12, new Date(parseDay(week)).toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' }));
    });
    legends.forEach((legend, r) => {
      const y = m.top + r * cellH;
      text(svg, m.left - 6, y + cellH - 4, legend, { 'text-anchor': 'end', ...(legend === 'Bloodhound' ? { class: 'label-strong' } : {}) });
      grid[legend].forEach((v, c) => {
        if (v === null) return;
        const cell = el('rect', { x: m.left + c * cellW + 1, y: y + 1, width: Math.max(1, cellW - 2), height: cellH - 2, rx: 2, fill: RAMP[binOf(v)] }, svg);
        cell.addEventListener('pointermove', ((event: PointerEvent) => showTip(`<strong>${legend}</strong><br>Week of ${fmtDay(parseDay(data.weeks[c]))}<br>${v.toFixed(2)}%`, event)) as EventListener);
        cell.addEventListener('pointerleave', hideTip);
      });
      if (legend === 'Bloodhound') el('rect', { x: m.left, y: y + 0.5, width: width - m.left - m.right, height: cellH - 1, fill: 'none', stroke: LINE, 'stroke-width': 1.5, rx: 3 }, svg);
    });
    const key = document.getElementById('heat-legend')!;
    key.replaceChildren();
    const labels = ['<1%', ...bins.slice(0, -1).map((b, i) => `${b}–${bins[i + 1]}%`), `${bins[bins.length - 1]}%+`];
    labels.forEach((label, i) => {
      const swatch = document.createElement('span');
      swatch.className = 'swatch';
      swatch.style.background = RAMP[i];
      const caption = document.createElement('span');
      caption.textContent = label;
      key.append(swatch, caption);
    });
  }

  const drawAll = () => { drawDaily(); drawRanks(); drawJumps(); drawSnapshot(); drawHeatmap(); };
  drawAll();
  let resizeFrame = 0;
  new ResizeObserver(() => { cancelAnimationFrame(resizeFrame); resizeFrame = requestAnimationFrame(drawAll); }).observe(document.querySelector('.assignment')!);
</script>
