---
import { getCollection, render } from 'astro:content';
import ContentArticle from '../../components/ContentArticle.astro';
import SectionLayout from '../../layouts/SectionLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<SectionLayout title={`${project.data.title} — broccosite`} description={project.data.description ?? project.data.title} section="projects">
  <ContentArticle title={project.data.title} backHref="/projects/" backLabel="projects" publishedDate={project.data.publishedDate} updatedDate={project.data.updatedDate}>
    <Content />
  </ContentArticle>
</SectionLayout>
