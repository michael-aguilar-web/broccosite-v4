---
import { getEntry, render } from 'astro:content';
import ContentArticle from '../components/ContentArticle.astro';
import SectionLayout from '../layouts/SectionLayout.astro';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing about page content');
const { Content } = await render(page);
---

<SectionLayout title="About — broccosite" description={page.data.description ?? 'About Michael, aka Broccoli.'} section="about">
  <ContentArticle title={page.data.title} publishedDate={page.data.publishedDate} updatedDate={page.data.updatedDate}>
    <Content />
  </ContentArticle>
</SectionLayout>
