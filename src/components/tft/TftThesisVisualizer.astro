---
import { graphHeight, phases, rounds } from './examples';
import { renderGraph } from './graph';
import { tftComponents } from './components';

const icons = Object.fromEntries(Object.entries(tftComponents).map(([id, component]) => [id, component.image.src]));
---

<tft-thesis-visualizer class="tft-flow" data-knowledge="3" data-icons={JSON.stringify(icons)}>
  <div class="flow-caption">
    <span class="flow-hint"><span class="flow-hover-hint">hover</span><span class="flow-tap-hint">tap</span>{" to explore"}</span>
  </div>
  <div class="flow-knowledge">
    <div class="flow-knowledge-heading"><label for="tft-known-lines">lines you know</label><output for="tft-known-lines" data-count>3</output></div>
    <input id="tft-known-lines" type="range" min="1" max="12" step="1" value="3" aria-valuetext="3 known lines" />
    <div class="flow-knowledge-ticks" aria-hidden="true"><span>1</span><span>12</span></div>
  </div>
  <div class="flow-frame">
  <div class="flow-chart" role="group" aria-label="The same TFT game viewed with different numbers of known lines">
    <div class="flow-rounds" aria-label="Round timeline">
      {rounds.map((round) => <span style={`top:${round.y / graphHeight * 100}%`}>{round.label}</span>)}
    </div>
    {phases.map((phase) => (
      <div class="flow-phase" style={`top:${phase.y / graphHeight * 100}%`}><span>{phase.label}</span></div>
    ))}
    <div class="flow-plot">
      {phases.map((phase) => <span class="flow-guide" style={`top:${phase.y / graphHeight * 100}%`} aria-hidden="true" />)}
      <div class="flow-dynamic" set:html={renderGraph(3, icons)} />
    </div>
  </div>
  </div>
  <div class="flow-popup" hidden>
    <button type="button" class="flow-dismiss" aria-label="Close explanation">×</button>
    <div id="tft-flow-detail" role="tooltip">
      <p class="flow-detail-context" data-context></p>
      <h2 data-title></h2>
      <p data-body></p>
      <div class="flow-board" hidden><h3>Current board</h3><p data-board></p></div>
      <p class="flow-note" data-note hidden></p>
    </div>
  </div>
  <noscript><p>With three known lines, you can play toward AP Comp 2 but still need its carry. Adding AP Comp 1 lets you recognize a better fit: the same items, augment, and natural units fit that line better. Twelve adds other lines without a better fit for this hand. Enable JavaScript to compare these settings.</p></noscript>
</tft-thesis-visualizer>

<script>
  import { detailFor, knowledgeState, type KnowledgeCount } from './examples';
  import { renderGraph } from './graph';

  class TftThesisVisualizer extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      if (this.cleanup) return;
      const controller = new AbortController();
      const { signal } = controller;
      const popup = this.querySelector<HTMLElement>('.flow-popup')!;
      const slider = this.querySelector<HTMLInputElement>('input[type="range"]')!;
      let knowledge: KnowledgeCount = 3;
      const tooltip = this.querySelector<HTMLElement>('[role="tooltip"]')!;
      const close = this.querySelector<HTMLButtonElement>('.flow-dismiss')!;
      const hover = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 601px)');
      let active: Element | null = null;
      let lastTapped: Element | null = null;
      let anchor: { x: number; y: number } | null = null;
      let pinned = false;
      let timer: ReturnType<typeof setTimeout> | undefined;
      // Keep aria-describedby unique if this component is reused on one page.
      tooltip.id = `tft-flow-detail-${crypto.randomUUID()}`;
      this.querySelectorAll('button[aria-describedby]').forEach((node) => node.setAttribute('aria-describedby', tooltip.id));
      slider.id = `${tooltip.id}-knowledge`;
      this.querySelector<HTMLLabelElement>('.flow-knowledge label')!.htmlFor = slider.id;
      this.querySelector('output')!.setAttribute('for', slider.id);

      const position = () => {
        if (!active || popup.hidden) return;
        if (!hover.matches) {
          popup.style.left = '12px';
          popup.style.right = '12px';
          popup.style.bottom = '12px';
          popup.style.top = 'auto';
          return;
        }
        popup.style.right = 'auto';
        popup.style.bottom = 'auto';
        const bounds = anchor ? { right: anchor.x, left: anchor.x, top: anchor.y } : active.getBoundingClientRect();
        const width = popup.offsetWidth;
        const height = popup.offsetHeight;
        const proposed = bounds.right + 14;
        const left = proposed + width <= window.innerWidth - 12 ? proposed : bounds.left - width - 14;
        popup.style.left = `${Math.max(12, Math.min(left, window.innerWidth - width - 12))}px`;
        popup.style.top = `${Math.max(12, Math.min(bounds.top - 12, window.innerHeight - height - 12))}px`;
      };
      const cancelHide = () => clearTimeout(timer);
      const hide = () => {
        cancelHide();
        popup.hidden = true;
        this.classList.remove('is-inspecting');
        this.querySelectorAll('[data-highlight]').forEach((node) => node.removeAttribute('data-highlight'));
        active = null;
        lastTapped = null;
        anchor = null;
        pinned = false;
      };
      const scheduleHide = () => {
        cancelHide();
        if (!pinned) timer = setTimeout(hide, 180);
      };
      const show = (node: Element, point?: { x: number; y: number }) => {
        const detail = detailFor(node.getAttribute('data-detail') ?? '', knowledge);
        if (!detail) return;
        cancelHide();
        active = node;
        anchor = node instanceof SVGElement ? point ?? null : null;
        const write = (selector: string, value: string) => { popup.querySelector<HTMLElement>(selector)!.textContent = value; };
        write('[data-context]', detail.context);
        write('[data-title]', detail.title);
        write('[data-body]', detail.body);
        write('[data-board]', detail.board ?? '');
        write('[data-note]', detail.note ?? '');
        popup.querySelector<HTMLElement>('.flow-board')!.hidden = !detail.board;
        popup.querySelector<HTMLElement>('[data-note]')!.hidden = !detail.note;
        popup.hidden = false;
        this.classList.add('is-inspecting');
        this.querySelectorAll<HTMLElement | SVGElement>('[data-lines], [data-wire-line], [data-event-wires]').forEach((element) => {
          const related = element.getAttribute('data-lines')?.split(' ') ?? [element.getAttribute('data-wire-line') ?? ''];
          const highlighted = related.some((id) => detail.lines.includes(id as typeof detail.lines[number])) || element.getAttribute('data-event-wires') === detail.id;
          element.setAttribute('data-highlight', String(highlighted));
        });
        position();
      };
      const renderKnowledge = () => {
        hide();
        knowledge = Number(slider.value);
        const state = knowledgeState(knowledge);
        this.dataset.knowledge = String(knowledge);
        this.toggleAttribute('data-dense', knowledge > 6);
        this.querySelector('output')!.textContent = String(knowledge);
        slider.setAttribute('aria-valuetext', `${knowledge} known lines. ${state.status}`);
        const graph = this.querySelector<HTMLElement>('.flow-dynamic')!;
        graph.innerHTML = renderGraph(knowledge, JSON.parse(this.dataset.icons!), tooltip.id);
        this.querySelectorAll<HTMLButtonElement>('button[data-detail]').forEach(node => {
          const detail = detailFor(node.dataset.detail!, knowledge);
          if (detail) node.setAttribute('aria-label', `${detail.context}: ${detail.title}`);
        });
      };
      slider.addEventListener('input', renderKnowledge, { signal });
      renderKnowledge();
      this.addEventListener('pointerover', (event) => {
        if (!hover.matches || pinned) return;
        const node = (event.target as Element).closest('[data-detail]');
        if (node && this.contains(node)) {
          if (node !== active) show(node, { x: event.clientX, y: event.clientY });
          else cancelHide();
        }
      }, { signal });
      this.addEventListener('pointerout', (event) => {
        if (!hover.matches || pinned) return;
        const next = event.relatedTarget as Node | null;
        if (next && (active?.contains(next) || popup.contains(next))) return;
        if ((event.target as Element).closest('[data-detail]')) scheduleHide();
      }, { signal });
      popup.addEventListener('pointerenter', cancelHide, { signal });
      popup.addEventListener('pointerleave', () => { if (hover.matches) scheduleHide(); }, { signal });
      this.addEventListener('focusin', (event) => {
        const node = (event.target as Element).closest('[data-detail]');
        if (node) show(node);
      }, { signal });
      this.addEventListener('focusout', (event) => {
        if (!pinned && !popup.contains(event.relatedTarget as Node | null)) scheduleHide();
      }, { signal });
      this.addEventListener('click', (event) => {
        const node = (event.target as Element).closest('[data-detail]');
        if (node) {
          if (!hover.matches && pinned && node === lastTapped) hide();
          else { show(node); pinned = !hover.matches; lastTapped = node; }
        }
      }, { signal });
      const dismiss = () => {
        const prior = active;
        if (document.activeElement === close && prior instanceof HTMLElement) prior.focus({ preventScroll: true });
        hide();
      };
      close.addEventListener('click', dismiss, { signal });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !popup.hidden) dismiss(); }, { signal });
      document.addEventListener('pointerdown', (event) => {
        const target = event.target as Element;
        if (!popup.contains(target) && !target.closest('tft-thesis-visualizer [data-detail]')) hide();
      }, { signal });
      window.addEventListener('resize', position, { signal });
      window.addEventListener('scroll', () => { if (hover.matches) hide(); }, { signal, passive: true });
      this.cleanup = () => { controller.abort(); cancelHide(); };
    }
    disconnectedCallback() { this.cleanup?.(); this.cleanup = undefined; }
  }
  if (!customElements.get('tft-thesis-visualizer')) customElements.define('tft-thesis-visualizer', TftThesisVisualizer);
</script>

<style is:global>
  tft-thesis-visualizer.tft-flow { display: block; position: relative; margin: 0 0 1.5rem; color: var(--ink); border: 1px solid var(--line-soft); border-radius: var(--radius-card); background: var(--surface); line-height: 1.45; }
  tft-thesis-visualizer.tft-flow [hidden] { display: none !important; }
  tft-thesis-visualizer .flow-caption { display: flex; justify-content: flex-end; align-items: baseline; gap: 1rem; padding: 1rem 1.25rem 0; font-size: 0.88rem; }
  tft-thesis-visualizer .flow-hint { color: var(--muted); font-size: 0.75rem; }
  tft-thesis-visualizer .flow-tap-hint { display: none; }
  tft-thesis-visualizer .flow-knowledge { max-width: 27rem; margin: 1.15rem auto 0.3rem; padding: 0 1.25rem; }
  tft-thesis-visualizer .flow-knowledge-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; font-size: 0.85rem; }
  tft-thesis-visualizer .flow-knowledge output { color: var(--leaf-dark); font-size: 1rem; font-variant-numeric: tabular-nums; font-weight: 600; }
  tft-thesis-visualizer .flow-knowledge input { display: block; width: 100%; height: 36px; margin: 0; accent-color: var(--leaf); cursor: pointer; }
  tft-thesis-visualizer .flow-knowledge-ticks { display: flex; justify-content: space-between; margin: -0.2rem 0 0.65rem; padding-inline: 0.35rem; color: var(--muted); font-size: 0.7rem; }
  tft-thesis-visualizer .flow-frame { width: 100%; min-width: 0; }
  tft-thesis-visualizer .flow-dynamic { position: absolute; inset: 0; }
  tft-thesis-visualizer .flow-chart { position: relative; height: 912px; margin: 1.5rem 0 0; }
  tft-thesis-visualizer .flow-rounds { position: absolute; inset: 0 auto 0 0; width: 7.75rem; color: var(--muted); font-size: 0.65rem; font-variant-numeric: tabular-nums; }
  tft-thesis-visualizer .flow-rounds span { position: absolute; right: 0.65rem; transform: translateY(-50%); }
  tft-thesis-visualizer .flow-rounds span::after { position: absolute; left: calc(100% + 0.4rem); top: 50%; width: 5px; height: 1px; background: var(--line); content: ''; }
  tft-thesis-visualizer .flow-plot { position: absolute; inset: 0 1.1rem 0 8rem; background-image: radial-gradient(var(--line-soft) 0.65px, transparent 0.65px); background-size: 18px 18px; }
  tft-thesis-visualizer .flow-phase { position: absolute; left: 0.9rem; width: 6.25rem; transform: translateY(-50%); pointer-events: none; }
  tft-thesis-visualizer .flow-phase span { color: var(--muted); font-size: 0.75rem; font-weight: 500; line-height: 1.25; }
  tft-thesis-visualizer .flow-guide { position: absolute; left: 0; right: 0; height: 1px; background: var(--line-soft); opacity: 0.5; pointer-events: none; }
  tft-thesis-visualizer .flow-family { position: absolute; top: 0; height: 20px; border-bottom: 1px solid var(--line-soft); color: var(--muted); font-size: 0.75rem; font-weight: 500; }
  tft-thesis-visualizer .flow-family span { position: absolute; left: 50%; top: -3px; transform: translateX(-50%); }
  tft-thesis-visualizer .flow-wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  tft-thesis-visualizer .flow-wires path { fill: none; vector-effect: non-scaling-stroke; }
  tft-thesis-visualizer .flow-track { stroke: var(--comp-color); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  tft-thesis-visualizer .flow-track.is-strong { stroke-width: 4; }
  tft-thesis-visualizer .flow-track.is-muted { stroke-dasharray: 3 5; opacity: 0.3; stroke-width: 1.5; }
  tft-thesis-visualizer .flow-track.is-missing { stroke-dasharray: 5 6; }
  tft-thesis-visualizer .flow-line[data-preferred='true'] .flow-track:not(.is-muted) { stroke-width: 3.2; }
  tft-thesis-visualizer .flow-line[data-preferred='true'] .flow-track.is-strong { stroke-width: 4; }
  tft-thesis-visualizer .flow-input { stroke: var(--muted); opacity: 0.55; stroke-width: 1.2; }
  tft-thesis-visualizer .flow-station { fill: var(--surface); fill-opacity: 0.72; stroke: var(--muted); stroke-width: 1.2; vector-effect: non-scaling-stroke; }
  tft-thesis-visualizer .flow-hit { stroke: transparent; stroke-width: 9; pointer-events: stroke; cursor: help; }
  tft-thesis-visualizer .flow-line { transition: opacity 130ms ease; }
  tft-thesis-visualizer.is-inspecting .flow-line[data-highlight='false'] { opacity: 0.15; }
  tft-thesis-visualizer.is-inspecting .flow-line[data-highlight='true'] .flow-track { stroke-width: 3.3; }
  tft-thesis-visualizer.is-inspecting .flow-line[data-highlight='true'] .flow-track.is-strong { stroke-width: 4.5; }
  tft-thesis-visualizer.is-inspecting .flow-inputs[data-highlight='false'] { opacity: 0.06; }
  tft-thesis-visualizer.is-inspecting .flow-inputs[data-highlight='true'] { opacity: 0.7; }
  tft-thesis-visualizer.tft-flow button { font: inherit; -webkit-tap-highlight-color: transparent; }
  tft-thesis-visualizer .flow-origin, tft-thesis-visualizer .flow-event, tft-thesis-visualizer .flow-stop { position: absolute; padding: 0; border: 0; background: transparent; cursor: help; }
  tft-thesis-visualizer .flow-origin { top: 18px; width: var(--origin-width); height: 44px; transform: translateX(-50%); color: var(--comp-color); font-size: 0.75rem !important; text-align: center; }
  tft-thesis-visualizer .flow-comp-number { position: absolute; top: 22px; left: 50%; display: grid; place-items: center; transform: translate(-50%, -50%); width: 26px; height: 26px; border: 1.5px solid var(--comp-color); border-radius: 50%; background: var(--surface); color: var(--ink); font-size: 0.8rem; font-weight: 500; line-height: 1; }
  tft-thesis-visualizer .flow-origin:hover .flow-comp-number, tft-thesis-visualizer .flow-origin:focus-visible .flow-comp-number { background: var(--paper); border-width: 2px; }
  tft-thesis-visualizer .flow-stop { display: grid; width: 24px; height: 24px; place-items: center; transform: translate(-50%, -50%); color: var(--comp-color); font-size: 1.15rem !important; }
  tft-thesis-visualizer .flow-stop svg { display: block; width: 12px; height: 12px; overflow: visible; }
  tft-thesis-visualizer .flow-stop path { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  tft-thesis-visualizer .flow-stop[data-detail^='ad-'] { opacity: 0.45; }
  tft-thesis-visualizer .flow-event { display: grid; width: max-content; min-width: 44px; min-height: 44px; transform: translate(-50%, -50%); place-items: center; color: var(--muted); }
  tft-thesis-visualizer .flow-event-art { display: flex; align-items: center; justify-content: center; gap: 3px; padding: 3px; background: var(--surface); border-radius: 5px; }
  tft-thesis-visualizer .flow-event img { display: block; width: 30px; height: 30px; margin: 0; border-radius: 4px; }
  tft-thesis-visualizer .flow-event-label { position: absolute; top: calc(50% + 22px); left: 50%; transform: translateX(-50%); width: max-content; max-width: 90px; padding: 0 2px; background: var(--surface); font-size: 0.65rem; line-height: 1.2; text-align: center; pointer-events: none; }
  tft-thesis-visualizer .flow-event[data-detail='components'] .flow-event-label, tft-thesis-visualizer .flow-event[data-detail='krugs'] .flow-event-label, tft-thesis-visualizer .flow-event[data-detail='second-augment'] .flow-event-label { top: auto; bottom: calc(50% + 24px); }
  tft-thesis-visualizer .flow-glyph { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 1px solid currentColor; font-size: 1rem; font-weight: 600; }
  tft-thesis-visualizer .flow-glyph--augment { color: #8964b1; background: #eee8f5; }
  tft-thesis-visualizer .flow-glyph--unit { color: #956b13; background: #f8edce; border-radius: 5px; }
  tft-thesis-visualizer .flow-glyph--roll { color: var(--leaf-dark); background: var(--sprout); }
  tft-thesis-visualizer .flow-glyph--board { color: #357ec1; background: #e0edf9; }
  tft-thesis-visualizer .flow-event--board .flow-event-art { padding: 0; background: transparent; border-radius: 50%; }
  tft-thesis-visualizer .flow-event--board .flow-event-label { color: #28649b; font-size: 0.8rem; }
  tft-thesis-visualizer.tft-flow[data-knowledge='3'] .flow-glyph--board { color: #8964b1; background: #eee8f5; }
  tft-thesis-visualizer.tft-flow[data-knowledge='3'] .flow-event--board .flow-event-label { color: #8964b1; }
  tft-thesis-visualizer .flow-event:hover .flow-event-art, tft-thesis-visualizer .flow-event:focus-visible .flow-event-art { box-shadow: 0 0 0 2px var(--line); }
  tft-thesis-visualizer.is-inspecting .flow-origin[data-highlight='false'], tft-thesis-visualizer.is-inspecting .flow-stop[data-highlight='false'] { opacity: 0.35; }
  tft-thesis-visualizer .flow-popup { position: fixed; z-index: 40; width: 300px; max-width: calc(100vw - 24px); max-height: calc(100dvh - 24px); overflow-y: auto; padding: 1rem 1.1rem; border: 1px solid var(--line); border-radius: 0.6rem; background: var(--surface); box-shadow: 0 8px 30px #1b2f2426; }
  tft-thesis-visualizer.tft-flow .flow-detail-context { margin: 0 0 0.5rem; padding-right: 0.5rem; color: var(--muted); font-size: 0.7rem; }
  tft-thesis-visualizer.tft-flow .flow-popup h2 { margin: 0 0 0.7rem; font-size: 1.1rem; line-height: 1.25; }
  tft-thesis-visualizer.tft-flow .flow-popup p { font-size: 0.85rem; line-height: 1.5; }
  tft-thesis-visualizer.tft-flow .flow-popup [data-body] { margin: 0; }
  tft-thesis-visualizer .flow-board { margin-top: 0.8rem; padding-top: 0.7rem; border-top: 1px solid var(--line-soft); }
  tft-thesis-visualizer.tft-flow .flow-board h3 { margin: 0 0 0.3rem; font: 600 0.75rem/1.4 'Outfit', sans-serif; letter-spacing: 0; }
  tft-thesis-visualizer.tft-flow .flow-board p { margin: 0; color: var(--muted); }
  tft-thesis-visualizer.tft-flow .flow-popup .flow-note { margin: 0.8rem 0 0; color: var(--muted); font-size: 0.75rem; }
  tft-thesis-visualizer .flow-dismiss { display: none; }
  @media (hover: hover) and (pointer: fine) and (min-width: 601px) {
  tft-thesis-visualizer .flow-popup { pointer-events: none; }
  }
  @media (max-width: 600px) {
  tft-thesis-visualizer.tft-flow { margin-inline: -1.1rem; }
  tft-thesis-visualizer .flow-caption { padding: 0.85rem 0.7rem 0; gap: 0.5rem; font-size: 0.8rem; }
  tft-thesis-visualizer .flow-hint { font-size: 0.65rem; }
  tft-thesis-visualizer .flow-knowledge { margin-top: 1rem; padding-inline: 0.85rem; }
  tft-thesis-visualizer .flow-knowledge input { height: 44px; }
  tft-thesis-visualizer .flow-rounds { width: 3.5rem; font-size: 0.6rem; }
  tft-thesis-visualizer .flow-rounds span { right: 0.35rem; }
  tft-thesis-visualizer .flow-rounds span::after { left: calc(100% + 0.2rem); width: 3px; }
  tft-thesis-visualizer .flow-plot { left: 3.75rem; right: 0.85rem; }
  tft-thesis-visualizer .flow-phase { left: 0.4rem; width: 2.9rem; }
  tft-thesis-visualizer .flow-phase span { display: block; font-size: 0.65rem; }
  tft-thesis-visualizer .flow-comp-number { width: 18px; height: 22px; font-size: 0.7rem; }
  tft-thesis-visualizer[data-dense] .flow-comp-number { width: 14px; height: 20px; font-size: 0.65rem; border-width: 1px; }
  tft-thesis-visualizer .flow-event img { width: 24px; height: 24px; }
  tft-thesis-visualizer .flow-event-art { gap: 2px; padding: 2px; }
  tft-thesis-visualizer .flow-event[data-detail='components'] .flow-event-art { display: grid; grid-template-columns: repeat(2, 18px); }
  tft-thesis-visualizer .flow-event[data-detail='components'] img { width: 18px; height: 18px; }
  tft-thesis-visualizer .flow-event[data-detail='components'] img:last-child { grid-column: span 2; justify-self: center; }
  tft-thesis-visualizer .flow-event-label { font-size: 0.6rem; max-width: 62px; }
  tft-thesis-visualizer .flow-glyph { width: 28px; height: 28px; font-size: 0.9rem; }
  tft-thesis-visualizer .flow-track { stroke-width: 1.8; }
  tft-thesis-visualizer .flow-track.is-strong { stroke-width: 3.2; }
  tft-thesis-visualizer .flow-input { opacity: 0.3; }
  }
  @media (hover: none), (pointer: coarse), (max-width: 600px) {
  tft-thesis-visualizer .flow-hover-hint { display: none; }
  tft-thesis-visualizer .flow-tap-hint { display: inline; }
  tft-thesis-visualizer .flow-popup { width: auto; max-height: 46dvh; padding: 1rem; }
  tft-thesis-visualizer .flow-detail-context { padding-right: 2rem !important; }
  tft-thesis-visualizer .flow-dismiss { display: grid; position: absolute; right: 0.15rem; top: 0.1rem; width: 44px; height: 44px; place-items: center; padding: 0; border: 0; background: transparent; color: var(--muted); font-size: 1.4rem !important; cursor: pointer; }
  }
</style>
