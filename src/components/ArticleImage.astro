---
import { Image, type ImageMetadata } from 'astro:assets';

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  width?: number | string;
  height?: number | string;
  inline?: boolean;
  loading?: 'eager' | 'lazy';
}

const {
  src,
  alt = '',
  width,
  height,
  inline = false,
  loading = 'lazy',
} = Astro.props;

const toCssLength = (value: number | string) => typeof value === 'number' ? `${value}px` : value;
const inlineStyle = inline
  ? [
      width !== undefined ? `width: ${toCssLength(width)}` : '',
      height !== undefined ? `height: ${toCssLength(height)}` : '',
    ].filter(Boolean).join('; ')
  : undefined;
---

{typeof src === 'string' ? (
  <img
    class:list={['article-image', { 'article-image--inline': inline }]}
    {src}
    {alt}
    {width}
    {height}
    style={inlineStyle}
    loading={loading}
    decoding="async"
  />
) : (
  <Image
    class:list={['article-image', { 'article-image--inline': inline }]}
    src={src}
    alt={alt}
    width={typeof width === 'number' ? width : undefined}
    height={typeof height === 'number' ? height : undefined}
    layout={inline ? 'fixed' : 'constrained'}
    style={inlineStyle}
    loading={loading}
    decoding="async"
  />
)}

<style>
  :global(.article-image) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2.5rem auto;
    object-fit: contain;
  }

  :global(.article-image.article-image--inline) {
    display: inline-block;
    max-width: none;
    margin: 0;
    border-radius: 0;
    vertical-align: middle;
  }
</style>
